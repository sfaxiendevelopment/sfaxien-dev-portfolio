{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfaxien",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "CONTENT",
      "id": "6543424b8ed849ccb00ef03f4071e486"
    }
  ],
  "observability": {
    "enabled": true
  }
}
